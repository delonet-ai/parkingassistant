NODE_ENV=development
APP_TIMEZONE=Europe/Moscow

POSTGRES_DB=parkingassistant
POSTGRES_USER=parkingassistant
POSTGRES_PASSWORD=parkingassistant
POSTGRES_PORT=5432

API_PORT=3000
ADMIN_UI_PORT=3100
BOT_ADAPTER_PORT=3200

YANDEX_MESSENGER_BOT_TOKEN=change-me
YANDEX_MESSENGER_SIGNING_SECRET=change-me

# The scheduler's way into the closed API: it posts the five daily job routes with this value
# in `X-Service-Token` (ADR 007). Generate one per environment and never share it between the
# stand and production:  openssl rand -hex 32
# Left empty the header path stays off, the API answers 401 and no scheduled job runs.
JOBS_SERVICE_TOKEN=

JOBS_SCHEDULER_ENABLED=true
JOB_PROCESS_QUEUE_TIME=08:00
JOB_FREEZE_NEXT_DAY_TIME=19:00
JOB_LOCK_DEPARTURE_PLANS_TIME=07:00
